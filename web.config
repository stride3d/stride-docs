<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <httpProtocol>
            <customHeaders>
                <add name="Access-Control-Allow-Origin" value="*" />
            </customHeaders>
        </httpProtocol>
        <security>
            <requestFiltering allowDoubleEscaping="true" />
        </security>
        <staticContent>
            <clientCache cacheControlMaxAge="1.00:00:00" cacheControlMode="UseMaxAge" />
            <remove fileExtension=".html" />
            <remove fileExtension=".json" />
            <remove fileExtension=".css" />
            <remove fileExtension=".webp" />
            <remove fileExtension="woff" />
            <remove fileExtension="woff2" />
            <remove fileExtension=".mp4" />
            <remove fileExtension=".md" />
            <remove fileExtension=".yml" />
            <mimeMap fileExtension=".html" mimeType="text/html" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <mimeMap fileExtension=".css" mimeType="text/css" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <mimeMap fileExtension="woff" mimeType="application/x-font-woff" />
            <mimeMap fileExtension="woff2" mimeType="application/font-woff2" />
            <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
            <mimeMap fileExtension=".md" mimeType="text/plain" />
            <mimeMap fileExtension=".yml" mimeType="text/yaml" />
        </staticContent>
        <rewrite>
            <rules>
                <rule name="Redirect xenko.com to stride3d.net" stopProcessing="true">
                    <match url=".*" />
                    <conditions>
                        <add input="{HTTP_HOST}" pattern="^(.*)xenko\.com$" />
                    </conditions>
                    <action type="Redirect" url="https://{C:1}stride3d.net/{R:0}" redirectType="Permanent" />
                </rule>
                <rule name="Redirect root and 'latest' to 'latest/en/' ">
                    <match url="^(latest)?$" />
                    <action type="Redirect" url="latest/en/" redirectType="Found" />
                </rule>
                <rule name="Redirect 'latest/{1}' to 'latest/en/{1}' when language is missing from initial url">
                    <match url="^latest/(.*)" />
                    <conditions>
                        <add input="{R:1}" pattern="^(en|jp)(/|$)" negate="true" />
                    </conditions>
                    <action type="Redirect" url="latest/en/{R:1}" redirectType="Found"/>
                </rule>
                <!-- Also used by the Stride Launcher 5.x and older, which loads {version}/ReleaseNotes/ReleaseNotes.md -->
                <rule name="Redirect missing language to /en/" stopProcessing="true">
                    <match url="^(\d+\.\d+)/?(.*)$" />
                    <conditions>
                        <add input="{R:2}" pattern="^(en|jp)(/|$)" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Found" url="{R:1}/en/{R:2}" />
                </rule>
                <!-- Rename Xenko to Stride for 4.0+ and latest -->
                <rule name="Redirect uppercase Xenko to Stride for 4.0+">
                    <match url="(([4-9]|[1-9]\d+)\.\d*|latest)/(.*)(Xenko)(.*)" />
                    <action type="Redirect" redirectType="Permanent" url="{R:1}/{R:3}Stride{R:5}" />
                </rule>
                <rule name="Redirect lowercase xenko to stride for 4.0+">
                    <match url="(([4-9]|[1-9]\d+)\.\d*|latest)/(.*)(xenko)(.*)" />
                    <action type="Redirect" redirectType="Permanent" url="{R:1}/{R:3}stride{R:5}" />
                </rule>
                <!-- Contributors and community resources aren't versioned: any version redirects to latest -->
                <!-- Keep in sync with crossVersionSections in en/template/public/main.js (with release notes, see below) -->
                <rule name="Redirect cross-version sections to latest" stopProcessing="true">
                    <match url="^\d+\.\d+/(en|jp)/(contributors|community-resources)(/.*)?$" />
                    <action type="Redirect" redirectType="Found" url="latest/{R:1}/{R:2}{R:3}" />
                </rule>
                <!-- Release notes: latest has the ones of every released version (ReleaseNotes-{version}.md/.html, and their media),
                     so other versions redirect to it, unless latest doesn't have the file (a beta, or until 4.4 is latest).
                     Redirects (not rewrites), so that the Stride Launcher resolves the images of the release notes from where they really are.
                     The Stride Launcher (6.0+) loads latest/en/ReleaseNotes/ReleaseNotes-{version}.md, falling back to {version}/en/ReleaseNotes/ReleaseNotes-{version}.md (beta). -->
                <!-- The release notes of a version: its page (link of the navbar of that version) -->
                <rule name="Redirect release notes page of a version to latest" stopProcessing="true">
                    <match url="^(\d+\.\d+)/en/ReleaseNotes(?:/(?:ReleaseNotes\.html|index\.html)?)?$" />
                    <conditions>
                        <add input="{APPL_PHYSICAL_PATH}%latest_version%\en\ReleaseNotes\ReleaseNotes-{R:1}.html" matchType="IsFile" />
                    </conditions>
                    <action type="Redirect" redirectType="Found" url="latest/en/ReleaseNotes/ReleaseNotes-{R:1}.html" />
                </rule>
                <!-- The release notes of other versions (links of the sidebar of that version) -->
                <rule name="Redirect release notes of other versions to latest" stopProcessing="true">
                    <match url="^\d+\.\d+/en/ReleaseNotes/(ReleaseNotes-\d+\.\d+\.(?:md|html))$" />
                    <conditions>
                        <add input="{APPL_PHYSICAL_PATH}%latest_version%\en\ReleaseNotes\{R:1}" matchType="IsFile" />
                    </conditions>
                    <action type="Redirect" redirectType="Found" url="latest/en/ReleaseNotes/{R:1}" />
                </rule>
                <!-- The release notes of a version: its markdown, and its media resolved from {version}/ReleaseNotes/ (Stride Launcher 5.x and older) -->
                <!-- Obsolete when: no Stride Launcher 5.x or older is used anymore (no more requests to {version}/ReleaseNotes/ReleaseNotes.md in the logs),
                     together with the copy of ReleaseNotes.md in BuildDocs.ps1 -->
                <rule name="Redirect release notes markdown of a version to latest" stopProcessing="true">
                    <match url="^(\d+\.\d+)/en/ReleaseNotes/ReleaseNotes\.md$" />
                    <conditions>
                        <add input="{APPL_PHYSICAL_PATH}%latest_version%\en\ReleaseNotes\ReleaseNotes-{R:1}.md" matchType="IsFile" />
                    </conditions>
                    <action type="Redirect" redirectType="Found" url="latest/en/ReleaseNotes/ReleaseNotes-{R:1}.md" />
                </rule>
                <rule name="Redirect release notes media to latest" stopProcessing="true">
                    <match url="^\d+\.\d+/en/ReleaseNotes/(media/.+)$" />
                    <conditions>
                        <add input="{APPL_PHYSICAL_PATH}%latest_version%\en\ReleaseNotes\{R:1}" matchType="IsFile" />
                    </conditions>
                    <action type="Redirect" redirectType="Found" url="latest/en/ReleaseNotes/{R:1}" />
                </rule>
                <!-- %latest_version% is replaced by the latest version of versions.json (see BuildSiteRoot.ps1) -->
                <rule name="Rewrite URL for latest documentation">
                    <match url="latest(.*)" />
                    <action type="Rewrite" url="%latest_version%/{R:1}" />
                </rule>
            </rules>
        </rewrite>
        <httpErrors errorMode="Custom">
            <remove statusCode="404"/>
            <error statusCode="404" path="%latest_version%\en\404.html" responseMode="File" />
        </httpErrors>
    </system.webServer>
    <!-- versions.json changes when a version is added or becomes latest, it shouldn't stay cached for a full day -->
    <location path="versions.json">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMaxAge="01:00:00" cacheControlMode="UseMaxAge" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
