#/bin/sh

if [ $# -ne 2 -a $# -ne 1 ]; then
    gum style --foreground 2 "DESCRIPTION"
    printf "  A utility script for getting rid of unused media files.\n\n"
    gum style --foreground 2 "USAGE"
    printf "  $0 <mediaPath> (<searchPath>)\n\n"
    gum style --foreground 2 "DEPENDENCIES"
    printf "  - ag (the_silver_searcher)\n  - gum\n\n"
    exit 1
fi

SEARCHPREFIX=$(gum input --header "Specify file name prefix" --header.foreground=2 --cursor.foreground=111)
if [ $? -ne 0 ]; then exit 2; fi

DELETE=$(gum choose "Do not delete" "Enable autodelete" --header "Automatically delete files?" --header.foreground=2 --cursor.foreground="111")
if [ $? -ne 0 ]; then exit 2; fi

MEDIA="$1/*"

SEARCHPATH=$(pwd)
if [ $# == 2 ]; then
    SEARCHPATH=$2
fi

gum style --bold --border=normal --padding="0 4" --foreground 2 "Beginning search..."

for i in $MEDIA; do
    gum style --foreground 2 "Processing $i..."
	TXT="$SEARCHPREFIX${i##*/}"
	echo $TXT
	MATCHES=$(ag -Ql "$TXT" $SEARCHPATH)
	COUNT=$(printf '%s\n' "${MATCHES[@]}" | wc -w)

    if [[ $COUNT -gt 1 ]]; then
        # Handle found
        gum style --foreground 3 "  $TXT was found $COUNT times"
		for file in $MATCHES; do
		    echo "  - $file"
		done
    else
		# Handle not found
        gum style --foreground 111 "  $TXT not found used anywhere"
		if [[ "$DELETE" == "Enable autodelete" ]]; then
		    gum style --foreground 1 "Deleting $1/$i..."
			rm "$1/$i"
        fi
    fi
done
